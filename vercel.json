{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "installCommand": "sh ./install-vercel.sh",
  "buildCommand": "sh ./build-vercel.sh",
  "outputDirectory": "Clientory App/artifacts/clientory/dist/public",
  "redirects": [
    {
      "source": "/scan/:path*",
      "destination": "https://app.clientory.org",
      "permanent": false
    },
    {
      "source": "/firm/:path*",
      "destination": "https://app.clientory.org",
      "permanent": false
    },
    {
      "source": "/settings/billing",
      "destination": "https://app.clientory.org",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://o*.ingest.sentry.io https://o*.ingest.us.sentry.io https://vitals.vercel-insights.com https://us.i.posthog.com https://us-assets.i.posthog.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
